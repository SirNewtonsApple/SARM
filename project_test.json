{
  "calc_dir": "quench_npt_vasp",

  "poscar_comment": "Fe82Si4B11P3 randomly substitue FCC",

  "formula": {
    "counts": { "Fe": 82, "Si": 4, "B": 11, "P": 3 },
    "host": "Fe",
    "species_order": ["Fe", "Si", "B", "P"]
  },

  "structure": {
    "type": "fcc_random_alloy",
    "lattice_constant": 3.417,
    "seed": 100003
  },

  "vasp": {
    "command": "srun --mpi=pmi2 vasp_gam 1> vasp.out 2> vasp.error",
    "command_mode": "bash",

    "incar": {
      "SYSTEM": "test_npt",

      "ENCUT": 500,
      "ALGO": "Fast",
      "PREC": "Normal",
      "LREAL": "Auto",
      "LASPH": true,

      "ISMEAR": 1,
      "SIGMA": 0.2,
      "EDIFF": 1e-5,

      "IBRION": 0,
      "ISYM": 0,
      "MDALGO": 3,
      "ISIF": 3,
      "LANGEVIN_GAMMA": "4*5.0",
      "LANGEVIN_GAMMA_L": 5,
      "PMASS": 1000,

      "TEBEG": 3000,
      "NSW": 1000,
      "POTIM": 1.0,

      "KBLOCK": 10,
      "NBLOCK": 10,
      "NWRITE": 0,
      "LWAVE": true,
      "LCHARG": true,
      "NCORE": 8
    },

    "potcar": {
      "root": "/work/home/acds9eawpu/opt/src/vasp_pp/potpaw54/potpaw_PBE.54",
      "template": "{root}/{label}/POTCAR"
    },

    "files": {
      "KPOINTS": {
        "content": "Gamma\n0\nGamma\n1 1 1\n0 0 0\n"
      },
      "ICONST": {
        "content": "LA 1 2 0\nLA 1 3 0\nLA 2 3 0\nLR 1 0\nLR 2 0\nLR 3 0\nS  1  0  0  0  0  0 0\nS  0  1  0  0  0  0 0\nS  0  0  1  0  0  0 0\nS  0  0  0  1 -1  0 0\nS  0  0  0  1  0 -1 0\nS  0  0  0  0  1 -1 0\n"
      }
    }
  },

  "copy_rules": [
    {
      "src_dir": "prev_run_dir",
      "src_name": "CONTCAR",
      "dst": "POSCAR",
      "optional": true
    },
    {
      "src_dir": "prev_run_dir",
      "src_name": "WAVECAR",
      "dst": "WAVECAR",
      "optional": true
    },
    {
      "src_dir": "prev_run_dir",
      "src_name": "CHGCAR",
      "dst": "CHGCAR",
      "optional": true
    }
  ],

  "backup": {
    "enabled": true,
    "root": "backups"
  }
